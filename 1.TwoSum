import java.util.ArrayList;
class Solution {
    public int[] twoSum(int[] nums, int target) {
        //ArrayList<Integer> a=new ArrayList<Integer>();
        int[] a=new int[2];
        int size=nums.length;
        for (int i=0;i<size;i++){
            
            a[0]=i;
            for (int j=i+1;j<size;j++){
                if((nums[i]+nums[j])==target){
                    a[1]=j;
                    return a;
                }
            }
        }return null;
    }
}
